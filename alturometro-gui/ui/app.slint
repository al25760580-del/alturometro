import { Button, LineEdit, Switch, ScrollView } from "std-widgets.slint";

struct UnitItem {
    emoji: string,
    name: string,
    value: string,
    source: string,
    whole: string,
    has-whole: bool,
}

component UnitCard inherits Rectangle {
    in property <UnitItem> item;
    in property <bool> show-source;
    in property <bool> show-whole;
    height: card-col.preferred-height + 20px;
    border-radius: 10px;
    background: white;
    border-width: 1px;
    border-color: #e5e7eb;
    clip: true;

    card-col := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 6px;
        alignment: start;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: item.emoji;
                font-size: 22px;
            }
            VerticalLayout {
                spacing: 2px;
                alignment: center;
                Text {
                    text: item.name;
                    font-size: 14px;
                    font-weight: 700;
                    color: #0f172a;
                }
                Text {
                    text: item.value;
                    font-size: 26px;
                    font-weight: 800;
                    color: #4f46e5;
                }
            }
        }

        Text {
            text: item.source;
            font-size: 11px;
            color: #94a3b8;
            wrap: word-wrap;
            visible: show-source;
        }

        if show-whole && item.has-whole: Rectangle {
            height: 24px;
            border-radius: 6px;
            background: #ecfdf5;
            Text {
                text: item.whole;
                font-size: 11px;
                font-weight: 600;
                color: #059669;
                horizontal-alignment: center;
            }
        }
    }
}

export component App inherits Window {
    preferred-width: 480px;
    preferred-height: 760px;
    title: "Alturometro";
    background: #fafafa;

    in-out property <string> height-text: "";
    in-out property <bool> show-source: false;
    in-out property <bool> show-whole: true;
    in-out property <bool> has-results: false;
    in-out property <string> height-cm;
    in-out property <string> error-text;
    in-out property <[UnitItem]> units;

    callback do-calculate();
    callback copy-results();

    VerticalLayout {
        padding: 28px;
        spacing: 20px;

        Text {
            text: "Alturometro";
            font-size: 32px;
            font-weight: 900;
            color: #0f172a;
            horizontal-alignment: center;
        }
        Text {
            text: "Bananas, Big Macs, rubber ducks and more";
            font-size: 13px;
            color: #64748b;
            horizontal-alignment: center;
        }

        Rectangle {
            height: input-row.preferred-height + 20px;
            border-radius: 10px;
            background: white;
            border-width: 1px;
            border-color: #e5e7eb;

            input-row := HorizontalLayout {
                padding: 10px;
                spacing: 10px;
                input := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "Height in meters";
                    text <=> root.height-text;
                    font-size: 15px;
                    accepted => { root.do-calculate(); }
                }
                Button {
                    text: "Go";
                    primary: true;
                    clicked => { root.do-calculate(); }
                }
            }
        }

        if error-text != "": Rectangle {
            height: err.preferred-height + 16px;
            border-radius: 8px;
            background: #fef2f2;
            border-width: 1px;
            border-color: #fecaca;
            err := Text {
                x: 12px; y: 8px;
                width: parent.width - 24px;
                text: root.error-text;
                color: #dc2626;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 24px;
            Switch {
                text: "Sources";
                checked <=> root.show-source;
            }
            Switch {
                text: "Pieces";
                checked <=> root.show-whole;
            }
        }

        if has-results: Rectangle {
            height: 42px;
            border-radius: 8px;
            background: #eef2ff;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: center;
                Text {
                    text: height-text + " m";
                    font-size: 15px;
                    font-weight: 700;
                    color: #4338ca;
                }
                Rectangle { width: 1px; height: 20px; background: #c7d2fe; }
                Text {
                    text: height-cm;
                    font-size: 15px;
                    font-weight: 600;
                    color: #6366f1;
                }
            }
        }

        if has-results: HorizontalLayout {
            alignment: center;
            copy-btn := Button {
                text: "Copy";
                clicked => { root.copy-results(); }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                for item[i] in root.units: UnitCard {
                    item: item;
                    show-source: root.show-source;
                    show-whole: root.show-whole;
                }
            }
        }

        Text {
            text: "All numbers are approximate. Sizes vary.";
            font-size: 10px;
            color: #94a3b8;
            horizontal-alignment: center;
        }
    }
}